# Public HTTPS origin used for canonical, Open Graph, and X/Twitter preview URLs.
SITE_URL=https://fairyfromalfeya.ru

# Optional public ownership tokens from Google Search Console and Yandex Webmaster.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Public Yandex Metrica counter ID. It is read by the server at runtime and
# serialized into the page so the consent component can initialize it after
# the visitor allows analytics. It is not a secret.
YANDEX_METRICA_ID=

# Create a sending-only key at https://resend.com/api-keys
RESEND_API_KEY=

# Replace this with an address on your verified Resend domain for production.
RESEND_FROM_EMAIL="CV Website <contact@fairyfromalfeya.ru>"
